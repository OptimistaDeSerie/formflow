# Copy this file to .env and replace the placeholder values.
#   cp .env.example .env
# The real .env is never committed. It is listed in .gitignore.
# Use letters and numbers only in values, to avoid surprises.

# Your Docker Hub username (your Docker ID), lowercase letters and numbers only.
# It becomes part of the image names, for example yourname/formflow-backend.
DOCKERHUB_USER=replace_with_your_dockerhub_username

# Which version to build or run. Locally this stays local-dev.
# In the pipeline it becomes sha-<commit>, for example sha-a1b2c3d.
IMAGE_TAG=local-dev

# Database settings
DB_NAME=formflow
DB_USER=formflow
DB_PASSWORD=replace_with_a_long_random_password

# Port the website listens on. Keep 80 on the server.
# On your Mac, if port 80 is busy, change this to 8080 and open http://localhost:8080
HTTP_PORT=80
